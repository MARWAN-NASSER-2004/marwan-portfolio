        target_content: "export default function App() {\n  return <div></div>;\n}"
        replacement_content: "export default function App() {\n  return (\n    <div className=\"min-h-screen bg-black text-neutral-300 font-sans selection:bg-neutral-800\">\n      \n      {/* Background purely black */}\n      <div className=\"absolute inset-0 bg-black pointer-events-none\" />\n\n      {/* Main Content Container */}\n      <div className=\"relative z-10 p-8 md:p-12 lg:p-16 h-screen flex flex-col justify-between\">\n        \n        {/* TOP ROW */}\n        <div className=\"flex justify-between items-start\">\n          \n          {/* Main Hero Title */}\n          <div className=\"max-w-xl\">\n            <h1 className=\"text-5xl md:text-7xl lg:text-[5.5rem] leading-[0.9] font-medium tracking-wide text-[#e5e5e5] mb-8\">\n              MARWANX //\n              <br />\n              SYSTEM\n              <br />\n              DEVELOPER\n            </h1>\n            <p className=\"text-[#a3a3a3] text-sm md:text-base leading-relaxed max-w-xs md:max-w-sm\">\n              Programmed with deep-web skills and a zero-latency stack for those who don\'t just write the markup\342\200\224they craft it. Shape your reality.\n            </p>\n          </div>\n\n          {/* Top Right Info */}\n          <div className=\"font-mono text-[10px] md:text-xs text-[#737373] flex items-center gap-4 uppercase tracking-widest mt-4\">\n            <span>1/26</span>\n            <div className=\"w-16 md:w-32 h-px bg-[#333]\"></div>\n            <span>NEXT PROJECT</span>\n          </div>\n        </div>\n\n        {/* MIDDLE RIGHT: Table */}\n        <div className=\"absolute top-1/2 right-8 md:right-16 -translate-y-1/2 w-72 md:w-[340px]\">\n          <h3 className=\"font-mono text-xs tracking-widest text-[#d4d4d4] mb-6 uppercase\">DEVELOPER SKILL</h3>\n          <ul className=\"flex flex-col text-sm border-t border-neutral-800/80\">\n            <li className=\"flex justify-between items-center py-4 border-b border-neutral-800/80\">\n              <span className=\"text-[#737373]\">Visual</span>\n              <span className=\"text-[#a3a3a3]\">React 18 NextJS-14</span>\n            </li>\n            <li className=\"flex justify-between items-center py-4 border-b border-neutral-800/80\">\n              <span className=\"text-[#737373]\">State</span>\n              <span className=\"text-[#a3a3a3]\">TS - State Manager</span>\n            </li>\n            <li className=\"flex justify-between items-center py-4 border-b border-neutral-800/80\">\n              <span className=\"text-[#737373]\">Motion</span>\n              <span className=\"text-[#a3a3a3]\">144Hz CSS-Motions</span>\n            </li>\n            <li className=\"flex justify-between items-center py-4 border-b border-neutral-800/80\">\n              <span className=\"text-[#737373]\">Build</span>\n              <span className=\"text-[#a3a3a3]\">Fullstack Vercel Web-App</span>\n            </li>\n          </ul>\n        </div>\n\n        {/* BOTTOM ROW */}\n        <div className=\"flex justify-between items-end\">\n          \n          {/* Bottom Left Card */}\n          <div className=\"border border-neutral-800/80 rounded-3xl p-6 md:p-8 max-w-[360px] bg-black/40 backdrop-blur-sm\">\n            <h4 className=\"font-mono text-xs text-[#a3a3a3] tracking-widest mb-4 uppercase\">MW-01: SYSTEM CORE</h4>\n            <p className=\"text-[#737373] text-sm leading-relaxed mb-6\">\n              High-level React skill and a clean\n              <br />\n              stack for scaling and clarity.\n            </p>\n            <button className=\"px-5 py-2.5 rounded-full border border-neutral-700 text-[#a3a3a3] text-sm hover:bg-neutral-900 hover:text-white transition-colors\">\n              Hire Marwan\n            </button>\n          </div>\n\n          {/* Bottom Right Pills */}\n          <div className=\"font-mono text-[10px] md:text-xs text-[#a3a3a3] flex items-center gap-3\">\n            <div className=\"px-4 py-2.5 border border-neutral-800 rounded-full flex items-center justify-center\">\n              JS/TSX\n            </div>\n            <div className=\"px-3.5 py-2.5 border border-neutral-800 rounded-full flex items-center justify-center\">\n              A+\n            </div>\n            <div className=\"flex border border-neutral-800 rounded-full overflow-hidden\">\n              <div className=\"px-5 py-2.5 border-r border-neutral-800\">\n                FULL-STACK\n              </div>\n              <div className=\"px-5 py-2.5\">\n                CLOUD-READY\n              </div>\n            </div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );\n}"
