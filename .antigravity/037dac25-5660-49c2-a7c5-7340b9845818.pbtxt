      target_content: "          {/* Main Hero Title */}\n          <div className=\"max-w-xl w-full\">\n            <h1 className=\"text-5xl md:text-7xl lg:text-[5.5rem] leading-[1] lg:leading-[0.9] font-medium tracking-wide text-[#e5e5e5] mb-6 lg:mb-8 mt-2 lg:mt-0\">\n              MARWANX //\n              <br />\n              SYSTEM\n              <br />\n              DEVELOPER\n            </h1>\n            <p className=\"text-[#a3a3a3] text-sm md:text-base leading-relaxed max-w-sm\">\n              Programmed with deep-web skills and a zero-latency stack for those who don\'t just write the markup\342\200\224they craft it. Shape your reality.\n            </p>\n          </div>\n\n          {/* Top Right Info */}\n          <div className=\"font-mono text-[10px] md:text-xs text-[#737373] flex items-center gap-4 uppercase tracking-widest mt-0 lg:mt-4 self-end lg:self-auto w-full lg:w-auto justify-end lg:justify-start\">\n            <span>1/26</span>\n            <div className=\"w-16 md:w-32 h-px bg-[#333]\"></div>\n            <span>NEXT PROJECT</span>\n          </div>"
