        target_content: "          {/* Main Hero Title */}\n          <div className=\"max-w-xl w-full\">\n            <h1 className=\"text-5xl md:text-7xl lg:text-[5.5rem] leading-[1] lg:leading-[0.9] font-medium tracking-wide text-[#e5e5e5] mb-6 lg:mb-8 mt-2 lg:mt-0\">\n              MARWANX //\n              <br />\n              SYSTEM\n              <br />\n              DEVELOPER\n            </h1>\n            <p className=\"text-[#a3a3a3] text-sm md:text-base leading-relaxed max-w-sm\">\n              Programmed with deep-web skills and a zero-latency stack for those who don\'t just write the markup\342\200\224they craft it. Shape your reality.\n            </p>\n          </div>\n\n          {/* Top Right Info */}\n          <div className=\"font-mono text-[10px] md:text-xs text-[#737373] flex items-center gap-4 uppercase tracking-widest mt-0 lg:mt-4 self-end lg:self-auto w-full lg:w-auto justify-end lg:justify-start\">\n            <span>1/26</span>\n            <div className=\"w-16 md:w-32 h-px bg-[#333]\"></div>\n            <span>NEXT PROJECT</span>\n          </div>"
        replacement_content: "          {/* Main Hero Title */}\n          <div className=\"max-w-xl w-full\">\n            <h1 className=\"text-5xl md:text-7xl lg:text-[5.5rem] leading-[1] lg:leading-[0.9] font-medium tracking-wide text-[#e5e5e5] mb-6 lg:mb-8 mt-2 lg:mt-0\">\n              {t.title1}\n              <br />\n              {t.title2}\n              <br />\n              {t.title3}\n            </h1>\n            <p className=\"text-[#a3a3a3] text-sm md:text-base leading-relaxed max-w-sm\">\n              {t.desc}\n            </p>\n          </div>\n\n          {/* Top Right Info */}\n          <div className=\"font-mono text-[10px] md:text-xs text-[#737373] flex items-center gap-4 uppercase tracking-widest mt-0 lg:mt-4 self-end lg:self-auto w-full lg:w-auto justify-end lg:justify-start\">\n            <button \n              onClick={() => setLang(isAr ? \'en\' : \'ar\')}\n              className=\"hover:text-white transition-colors border border-neutral-800 px-3 py-1 rounded-full cursor-pointer\"\n            >\n              {t.langToggle}\n            </button>\n            <span>1/26</span>\n            <div className=\"w-16 md:w-32 h-px bg-[#333]\"></div>\n            <span>{t.nextProj}</span>\n          </div>"
      }
      num_matches: 1
    }
    replacement_infos {
      original_chunk {
        target_content: "        {/* MIDDLE RIGHT: Table */}\n        <div className=\"relative lg:absolute lg:top-1/2 lg:right-8 xl:right-16 lg:-translate-y-1/2 w-full lg:w-[320px] xl:w-[340px] mt-4 lg:mt-0\">\n          <h3 className=\"font-mono text-xs tracking-widest text-[#d4d4d4] mb-4 lg:mb-6 uppercase\">DEVELOPER SKILL</h3>\n          <ul className=\"flex flex-col text-sm border-t border-neutral-800/80\">\n            <li className=\"flex justify-between items-center py-4 border-b border-neutral-800/80\">\n              <span className=\"text-[#737373]\">Visual</span>\n              <span className=\"text-[#a3a3a3]\">React 18 NextJS-14</span>\n            </li>\n            <li className=\"flex justify-between items-center py-4 border-b border-neutral-800/80\">\n              <span className=\"text-[#737373]\">State</span>\n              <span className=\"text-[#a3a3a3]\">TS - State Manager</span>\n            </li>\n            <li className=\"flex justify-between items-center py-4 border-b border-neutral-800/80\">\n              <span className=\"text-[#737373]\">Motion</span>\n              <span className=\"text-[#a3a3a3]\">144Hz CSS-Motions</span>\n            </li>\n            <li className=\"flex justify-between items-center py-4 border-b border-neutral-800/80\">\n              <span className=\"text-[#737373]\">Build</span>\n              <span className=\"text-[#a3a3a3]\">Fullstack Vercel Web-App</span>\n            </li>\n          </ul>\n        </div>"
        replacement_content: "        {/* MIDDLE RIGHT: Table */}\n        <div className=\"relative lg:absolute lg:top-1/2 lg:end-8 xl:end-16 lg:-translate-y-1/2 w-full lg:w-[320px] xl:w-[340px] mt-4 lg:mt-0\">\n          <h3 className=\"font-mono text-xs tracking-widest text-[#d4d4d4] mb-4 lg:mb-6 uppercase\">{t.devSkill}</h3>\n          <ul className=\"flex flex-col text-sm border-t border-neutral-800/80\">\n            {t.skills.map((skill, index) => (\n              <li key={index} className=\"flex justify-between items-center py-4 border-b border-neutral-800/80\">\n                <span className=\"text-[#737373]\">{skill.label}</span>\n                <span className=\"text-[#a3a3a3]\">{skill.value}</span>\n              </li>\n            ))}\n          </ul>\n        </div>"
      }
      num_matches: 1
    }
    replacement_infos {
      original_chunk {
        target_content: "          {/* Bottom Left Card */}\n          <div className=\"border border-neutral-800/80 rounded-3xl p-6 md:p-8 w-full max-w-full lg:max-w-[360px] bg-black/40 backdrop-blur-sm\">\n            <h4 className=\"font-mono text-xs text-[#a3a3a3] tracking-widest mb-4 uppercase\">MW-01: SYSTEM CORE</h4>\n            <p className=\"text-[#737373] text-sm leading-relaxed mb-6\">\n              High-level React skill and a clean\n              <br className=\"hidden sm:block\" />\n              stack for scaling and clarity.\n            </p>\n            <button className=\"px-5 py-2.5 rounded-full border border-neutral-700 text-[#a3a3a3] text-sm hover:bg-neutral-900 hover:text-white transition-colors w-full sm:w-auto\">\n              Hire Marwan\n            </button>\n          </div>\n\n          {/* Bottom Right Pills */}\n          <div className=\"font-mono text-[10px] sm:text-xs text-[#a3a3a3] flex flex-wrap lg:flex-nowrap items-center gap-2 sm:gap-3 w-full lg:w-auto pb-4 lg:pb-0 justify-start lg:justify-end\">\n            <div className=\"px-4 py-2.5 border border-neutral-800 rounded-full flex items-center justify-center shrink-0\">\n              JS/TSX\n            </div>\n            <div className=\"px-3.5 py-2.5 border border-neutral-800 rounded-full flex items-center justify-center shrink-0\">\n              A+\n            </div>\n            <div className=\"flex border border-neutral-800 rounded-full overflow-hidden shrink-0\">\n              <div className=\"px-4 sm:px-5 py-2.5 border-r border-neutral-800\">\n                FULL-STACK\n              </div>\n              <div className=\"px-4 sm:px-5 py-2.5\">\n                CLOUD-READY\n              </div>\n            </div>\n          </div>"
        replacement_content: "          {/* Bottom Left Card */}\n          <div className=\"border border-neutral-800/80 rounded-3xl p-6 md:p-8 w-full max-w-full lg:max-w-[360px] bg-black/40 backdrop-blur-sm\">\n            <h4 className=\"font-mono text-xs text-[#a3a3a3] tracking-widest mb-4 uppercase\">{t.cardTitle}</h4>\n            <p className=\"text-[#737373] text-sm leading-relaxed mb-6\">\n              {t.cardDesc1}\n              <br className=\"hidden sm:block\" />\n              {t.cardDesc2}\n            </p>\n            <button className=\"px-5 py-2.5 rounded-full border border-neutral-700 text-[#a3a3a3] text-sm hover:bg-neutral-900 hover:text-white transition-colors w-full sm:w-auto cursor-pointer\">\n              {t.hireBtn}\n            </button>\n          </div>\n\n          {/* Bottom Right Pills */}\n          <div className=\"font-mono text-[10px] sm:text-xs text-[#a3a3a3] flex flex-wrap lg:flex-nowrap items-center gap-2 sm:gap-3 w-full lg:w-auto pb-4 lg:pb-0 justify-start lg:justify-end\">\n            <div className=\"px-4 py-2.5 border border-neutral-800 rounded-full flex items-center justify-center shrink-0\">\n              JS/TSX\n            </div>\n            <div className=\"px-3.5 py-2.5 border border-neutral-800 rounded-full flex items-center justify-center shrink-0\">\n              A+\n            </div>\n            <div className=\"flex border border-neutral-800 rounded-full overflow-hidden shrink-0\">\n              <div className=\"px-4 sm:px-5 py-2.5 border-e border-neutral-800\">\n                {t.pillFullStack}\n              </div>\n              <div className=\"px-4 sm:px-5 py-2.5\">\n                {t.pillCloudReady}\n              </div>\n            </div>\n          </div>"
      }
      num_matches: 1
    }
  }
}
